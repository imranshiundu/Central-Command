[Unit]
Description=C3NTR@L COMM@ND V1.1 Bot Service
Description=Advanced Telegram bot with monitoring and security features
After=network.target
Wants=network.target
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/imran/snap/C3NTR@L-COMM@ND-V1.1/bot
ExecStart=/home/imran/snap/C3NTR@L-COMM@ND-V1.1/bot/autostart/start_bot.sh monitor
ExecStop=/home/imran/snap/C3NTR@L-COMM@ND-V1.1/bot/autostart/start_bot.sh stop
ExecReload=/home/imran/snap/C3NTR@L-COMM@ND-V1.1/bot/autostart/start_bot.sh restart
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

# Environment variables for GUI applications
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/imran/.Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

# Security settings (optional - uncomment if needed)
# NoNewPrivileges=yes
# PrivateTmp=yes
# ProtectSystem=strict
# ProtectHome=yes
# ReadWritePaths=/home/imran/snap/C3NTR@L-COMM@ND-V1.1/bot

# Resource limits (optional)
# MemoryMax=512M
# CPUQuota=80%

[Install]
WantedBy=default.target
